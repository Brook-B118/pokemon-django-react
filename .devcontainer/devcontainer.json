{
  "name": "Pokemon Django Dev",
  "dockerComposeFile": "../docker-compose.yaml",
  "service": "web",
  "workspaceFolder": "/app",
  "remoteUser": "root",
  "overrideCommand": false,
  "forwardPorts": [8000],
  "postCreateCommand": "pip install --no-cache-dir -r /app/pokemon-project/requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "alexcvzz.vscode-sqlite",
        "batisteo.vscode-django",
        "eamodio.gitlens",
        "esbenp.prettier-vscode",
        "github.copilot",
        "github.copilot-chat",
        "jmkrivocapich.drawfolderstructure",
        "johnpapa.vscode-peacock",
        "mechatroner.rainbow-csv",
        "pkief.material-icon-theme"
      ]
    }
  }
}
